# Application
APP_NAME="AI Companion"
APP_VERSION="0.1.0"
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://companion:companion@localhost:5432/companion"

# Cache & Ephemeral Store (Redis)
REDIS_URL="redis://localhost:6379/0"

# Session Settings
SESSION_TOKEN_BYTES=48
SESSION_TTL_MINUTES=30
SESSION_MAX_CONTEXT_TURNS=10

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_FILE_UPLOADS_PER_SESSION=10

# File Upload
MAX_UPLOAD_SIZE_BYTES=10485760
UPLOAD_DIR="./uploads"

# LLM Providers
LLM_PROVIDER="gemini"
LLM_ECONOMICAL_MODEL="gemini-2.0-flash"
LLM_CAPABLE_MODEL="gemini-2.0-pro"
LLM_FALLBACK_MODEL=""
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# API Keys
GOOGLE_API_KEY=""
OPENAI_API_KEY=""

# Speech Providers (ASR / TTS)
ASR_PROVIDER="google"
TTS_PROVIDER="google"
SARVAM_API_KEY=""
GOOGLE_CLOUD_CREDENTIALS_PATH=""

# Web Search
SEARCH_PROVIDER="tavily"
TAVILY_API_KEY=""
SERPAPI_API_KEY=""

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Schedulers
REMINDER_POLL_INTERVAL_SECONDS=30
